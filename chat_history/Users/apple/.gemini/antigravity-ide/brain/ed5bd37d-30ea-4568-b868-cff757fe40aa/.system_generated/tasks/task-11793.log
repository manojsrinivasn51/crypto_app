n Padding(\n37:       padding: const EdgeInsets.symmetric(horizontal: 24),\n38:       child: _AnimatedCardWrapper(\n39:         onTap: () {\n40:           context.push(AppRoutes.attendanceReport);\n41:         },\n4\n<truncated 5444 bytes>\n          ),\n188:           ],\n189:         ),\n190:         const SizedBox(height: 8),\n191:         ClipRRect(\n192:           borderRadius: AppRadius.borderFull,\n193:           child: LinearProgressIndicator(\n194:             value: progress,\n195:             minHeight: 6,\n196:             backgroundColor: colors.primary.withValues(alpha: 0.1),\n197:             valueColor: AlwaysStoppedAnimation<Color>(colors.primary),\n198:           ),\n199:         ),\n200:       ],\n201:     );\n202:   }\n203: }\n204: \n205: class _AnimatedCardWrapper extends StatefulWidget {\n206:   final VoidCallback onTap;\n207:   final Widget child;\n208: \n209:   const _AnimatedCardWrapper({required this.onTap, required this.child});\n210: \n211:   @override\n212:   State<_AnimatedCardWrapper> createState() => _AnimatedCardWrapperState();\n213: }\n214: \n215: class _AnimatedCardWrapperState extends State<_AnimatedCardWrapper>\n216:     with SingleTickerProviderStateMixin {\n217:   late AnimationController _controller;\n218:   late Animation<double> _scaleAnimation;\n219: \n220:   @override\n221:   void initState() {\n222:     super.initState();\n223:     _controller = AnimationController(\n224:       vsync: this,\n225:       duration: const Duration(milliseconds: 150),\n226:     );\n227:     _scaleAnimation = Tween<double>(\n228:       begin: 1.0,\n229:       end: 0.98,\n230:     ).animate(CurvedAnimation(parent: _controller, curve: Curves.easeInOut));\n231:   }\n232: \n233:   @override\n234:   void dispose() {\n235:     _controller.dispose();\n236:     super.dispose();\n237:   }\n238: \n239:   @override\n240:   Widget build(BuildContext context) {\n241:     return GestureDetector(\n242:       onTapDown: (_) => _controller.forward(),\n243:       onTapUp: (_) {\n244:         _controller.reverse();\n245:         widget.onTap();\n246:       },\n247:       onTapCancel: () => _controller.reverse(),\n248:       child: ScaleTransition(scale: _scaleAnimation, child: widget.child),\n249:     );\n250:   }\n251: }\n252: \nThe above content shows the entire, complete file contents of the requested file.\n"}
